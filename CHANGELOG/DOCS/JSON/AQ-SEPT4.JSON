      "aqarion:criticalFindings": [
        {
          "id": "V114-CF1-graph-mismatch",
          "title": "c* graph mismatch",
          "description": "Full bipartite defect graph c_bip (with isolated R vertices) gives r=m-c_bip, c*_D=n-c_bip. Ordinary quotient graph c_q gives n-c_q graphic rank. Conflated in V112 promotion. Counterexample: n=4 T=(0,0,0,0) discrete Pi => c_bip=4 r=0 c*_D=0 but c_q=1 n-c_q=3",
          "evidence": "independent python recomputation, rank via SVD and graph certificate"
        },
        {
          "id": "V114-CF2-DVI-false",
          "title": "DVI false",
          "description": "Proposed rank = minimal additional scalar observables false. Row-space refinement fails and g1 < g_infty. Counterexamples: T=(0,0,1) Pi={{0,2},{1}} D=[[0.25,-0.5,0.25]...] row values identical on 0,2; T=(0,0,1,2) Pi={{0,2,3},{1}} rank 1 but closure dims [2,3,4] => g_infty=2",
          "replacement": "One-step escape theorem rank D = dim((I-P)K(V)) = dim(V+KV)-dim V"
        }
      ],
